# Copy this file to .env and fill in what you have. Leave blank to skip a source.

# Shopify Dev Dashboard app: client ID and secret are on the app's Overview page
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Older custom apps with a static shpat_ token can use SHOPIFY_TOKEN instead

# Meta Ads: App ID and Secret from developers.facebook.com > your app > App settings > Basic.
# Then click "Connect Meta" in the dashboard Settings (login lasts about 60 days).
META_APP_ID=
META_APP_SECRET=
META_AD_ACCOUNT_ID=
# Alternative: a non-expiring system user token
# META_TOKEN=

# How often to pull new data, in minutes
SYNC_MINUTES=30
PORT=3000
